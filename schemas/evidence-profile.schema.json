{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-profile.schema.json",
  "title": "EvidenceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "testId",
    "label",
    "kind",
    "method",
    "cutoff",
    "sensitivity",
    "specificity",
    "population",
    "rationale",
    "limitations",
    "sources",
    "lastReviewed"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "testId": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["curated", "custom", "scenario"] },
    "method": { "type": "string", "minLength": 1 },
    "cutoff": { "type": "string", "minLength": 1 },
    "procedure": { "type": "string", "minLength": 1 },
    "sensitivity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "specificity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "lrPositive": { "type": "number", "exclusiveMinimum": 0 },
    "lrNegative": { "type": "number", "minimum": 0 },
    "population": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "isDefault": { "type": "boolean" },
    "deviationFromProfileId": { "type": "string" },
    "deviationReason": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "diagnostic-test.schema.json#/$defs/source" }
    }
  },
  "if": {
    "properties": { "kind": { "const": "scenario" } }
  },
  "then": {
    "required": ["deviationReason"]
  }
}

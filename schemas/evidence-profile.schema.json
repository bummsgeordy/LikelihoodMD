{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-profile.schema.json",
  "title": "EvidenceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "testId",
    "label",
    "kind",
    "calculationMode",
    "method",
    "cutoff",
    "population",
    "rationale",
    "limitations",
    "sources",
    "lastReviewed",
    "reviewStatus",
    "evidenceQuality",
    "dataCompleteness"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "testId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "curated",
        "custom",
        "scenario"
      ]
    },
    "calculationMode": {
      "type": "string",
      "enum": [
        "binary-lr",
        "categorical",
        "workflow-only"
      ]
    },
    "lrDerivation": {
      "type": "string",
      "enum": [
        "reported",
        "derived"
      ]
    },
    "nonComputableReason": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "specimen": {
      "type": "string",
      "minLength": 1
    },
    "intendedUse": {
      "type": "string",
      "minLength": 1
    },
    "preanalyticRisk": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "unclear"
      ]
    },
    "applicabilityWarning": {
      "type": "string",
      "minLength": 1
    },
    "reviewPriority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "cutoff": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "sensitivity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "specificity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "lrPositive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "lrNegative": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sensitivityInterval": {
      "$ref": "#/$defs/interval"
    },
    "specificityInterval": {
      "$ref": "#/$defs/interval"
    },
    "lrPositiveInterval": {
      "$ref": "#/$defs/interval"
    },
    "lrNegativeInterval": {
      "$ref": "#/$defs/interval"
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "preanalytics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "medicationInterferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsePositiveReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falseNegativeReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretationCautions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementationNotes": {
      "type": "string",
      "minLength": 1
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "needs-review"
      ]
    },
    "evidenceQuality": {
      "type": "string",
      "enum": [
        "high",
        "moderate",
        "low",
        "expert-opinion",
        "unclear"
      ]
    },
    "dataCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "minimal"
      ]
    },
    "reviewNote": {
      "type": "string"
    },
    "isDefault": {
      "type": "boolean"
    },
    "deviationFromProfileId": {
      "type": "string"
    },
    "deviationReason": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "diagnostic-test.schema.json#/$defs/source"
      }
    },
    "sourceCheck": {
      "$ref": "source-check.schema.json"
    },
    "resultCategories": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "interpretation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "scenario"
          }
        }
      },
      "then": {
        "required": [
          "deviationReason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "calculationMode": {
            "const": "binary-lr"
          }
        }
      },
      "then": {
        "required": [
          "lrDerivation"
        ]
      },
      "else": {
        "required": [
          "nonComputableReason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "lrPositive"
              ]
            },
            {
              "required": [
                "lrNegative"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

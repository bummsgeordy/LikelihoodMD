{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/clinical-modifier.schema.json",
  "title": "ClinicalModifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conditionId",
    "label",
    "category",
    "direction",
    "rationale",
    "limitations",
    "sources",
    "lastReviewed",
    "kind"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "conditionId": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["Symptom", "Klinisches Zeichen", "Anamnese", "Kontext", "Labor/Vorbefund"]
    },
    "direction": {
      "type": "string",
      "enum": ["increases", "decreases", "uncertain"]
    },
    "probabilityFactor": { "type": "number", "exclusiveMinimum": 0 },
    "likelihoodRatio": { "type": "number", "exclusiveMinimum": 0 },
    "rationale": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "kind": { "type": "string", "enum": ["curated", "custom", "scenario"] },
    "custom": { "type": "boolean" },
    "deviationReason": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "year", "url", "kind", "note"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["Leitlinie", "Studie", "Review", "Lehrtext", "Lokale Annahme"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "if": {
    "properties": { "kind": { "const": "scenario" } }
  },
  "then": {
    "required": ["deviationReason"]
  }
}

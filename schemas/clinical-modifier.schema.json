{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/clinical-modifier.schema.json",
  "title": "ClinicalModifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conditionId",
    "label",
    "category",
    "direction",
    "rationale",
    "limitations",
    "sources",
    "lastReviewed",
    "kind",
    "quantificationStatus",
    "reviewStatus",
    "evidenceQuality",
    "dataCompleteness"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "conditionId": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["Symptom", "Klinisches Zeichen", "Anamnese", "Kontext", "Labor/Vorbefund"]
    },
    "direction": {
      "type": "string",
      "enum": ["increases", "decreases", "uncertain"]
    },
    "probabilityFactor": { "type": "number", "exclusiveMinimum": 0 },
    "likelihoodRatio": { "type": "number", "exclusiveMinimum": 0 },
    "quantificationStatus": { "type": "string", "enum": ["qualitative", "probability-factor", "likelihood-ratio"] },
    "riskStratum": { "type": "string", "minLength": 1 },
    "mapsToPretestAssumptionId": { "type": "string", "minLength": 1 },
    "overlapWarning": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewStatus": { "type": "string", "enum": ["draft", "reviewed", "needs-review"] },
    "evidenceQuality": { "type": "string", "enum": ["high", "moderate", "low", "expert-opinion", "unclear"] },
    "dataCompleteness": { "type": "string", "enum": ["complete", "partial", "minimal"] },
    "reviewNote": { "type": "string" },
    "kind": { "type": "string", "enum": ["curated", "custom", "scenario"] },
    "custom": { "type": "boolean" },
    "deviationReason": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "year", "url", "kind", "note"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "pattern": "^https?://" },
        "kind": {
          "type": "string",
          "enum": ["Leitlinie", "Studie", "Review", "Lehrtext", "Lokale Annahme"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "if": {
    "properties": { "kind": { "const": "scenario" } }
  },
  "then": {
    "required": ["deviationReason"]
  },
  "allOf": [
    {
      "if": {
        "required": ["mapsToPretestAssumptionId"]
      },
      "then": {
        "required": ["overlapWarning"]
      }
    }
  ]
}

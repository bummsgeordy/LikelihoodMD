{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likelihoodmd.local/schemas/practice-question.schema.json",
  "title": "PracticeQuestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conditionId",
    "label",
    "contexts",
    "testIds",
    "indication",
    "prerequisites",
    "results",
    "urgent",
    "burden",
    "reflection",
    "sources",
    "lastReviewed",
    "reviewStatus",
    "evidenceQuality",
    "dataCompleteness",
    "sourceCheck"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "conditionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "indication": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "urgent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "burden": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "reflection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "testIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "screening",
          "suspicion",
          "incidental",
          "follow-up"
        ]
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "abnormal",
        "borderline",
        "discordant",
        "uninterpretable"
      ],
      "properties": {
        "normal": {
          "type": "string",
          "minLength": 1
        },
        "abnormal": {
          "type": "string",
          "minLength": 1
        },
        "borderline": {
          "type": "string",
          "minLength": 1
        },
        "discordant": {
          "type": "string",
          "minLength": 1
        },
        "uninterpretable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "year",
          "url",
          "kind",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "kind": {
            "enum": [
              "Leitlinie",
              "Studie",
              "Review",
              "Lehrtext",
              "Lokale Annahme"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "reviewed",
        "needs-review"
      ]
    },
    "evidenceQuality": {
      "enum": [
        "high",
        "moderate",
        "low",
        "expert-opinion",
        "unclear"
      ]
    },
    "dataCompleteness": {
      "enum": [
        "complete",
        "partial",
        "minimal"
      ]
    },
    "reviewNote": {
      "type": "string"
    },
    "sourceCheck": {
      "$ref": "source-check.schema.json"
    }
  }
}

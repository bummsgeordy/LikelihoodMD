{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likelihoodmd.local/schemas/condition-guidance.schema.json",
  "title": "ConditionGuidance",
  "type": "object",
  "required": [
    "conditionId",
    "summary",
    "whenToTest",
    "recommendedTests",
    "pitfalls",
    "settingNotes",
    "links",
    "lastReviewed",
    "reviewStatus",
    "evidenceQuality",
    "dataCompleteness"
  ],
  "properties": {
    "conditionId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "whenToTest": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommendedTests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "pitfalls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "settingNotes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "year", "url", "kind", "note"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 1900 },
          "url": { "type": "string", "pattern": "^https?://" },
          "kind": { "enum": ["Leitlinie", "Studie", "Review", "Lehrtext", "Lokale Annahme"] },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewStatus": { "enum": ["draft", "reviewed", "needs-review"] },
    "evidenceQuality": { "enum": ["high", "moderate", "low", "expert-opinion", "unclear"] },
    "dataCompleteness": { "enum": ["complete", "partial", "minimal"] },
    "reviewNote": { "type": "string" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/pretest-assumption.schema.json",
  "title": "PretestAssumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "condition",
    "conditionId",
    "setting",
    "settingId",
    "evidenceLevel",
    "population",
    "probability",
    "rationale",
    "limitations",
    "sources",
    "lastReviewed",
    "kind"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "condition": { "type": "string", "minLength": 1 },
    "conditionId": { "type": "string", "minLength": 1 },
    "setting": { "type": "string", "minLength": 1 },
    "settingId": { "type": "string", "minLength": 1 },
    "evidenceLevel": { "type": "string", "enum": ["direct", "fallback", "manual"] },
    "population": { "type": "string", "minLength": 1 },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "rangeLow": { "type": "number", "minimum": 0, "maximum": 1 },
    "rangeHigh": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "kind": { "type": "string", "enum": ["curated", "custom", "scenario"] },
    "custom": { "type": "boolean" },
    "deviationReason": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "year", "url", "kind", "note"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["Leitlinie", "Studie", "Review", "Lehrtext", "Lokale Annahme"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "if": {
    "properties": { "kind": { "const": "scenario" } }
  },
  "then": {
    "required": ["deviationReason"]
  }
}

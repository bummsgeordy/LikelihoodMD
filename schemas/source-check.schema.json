{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/source-check.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "checkedAt", "location", "note"],
  "properties": {
    "status": {"enum": ["verified", "restricted", "withdrawn"]},
    "checkedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "location": {"type": "string", "minLength": 1, "maxLength": 20000},
    "note": {"type": "string", "minLength": 1, "maxLength": 20000}
  }
}

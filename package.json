{
  "name": "likelihood-ratio-rechner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deutschsprachiges Lehr- und Rechentool für Vor- und Nachtestwahrscheinlichkeiten.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run validate:data && vite build",
    "check:pages": "node scripts/check-pages-build.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "preview": "vite preview",
    "test": "vitest src",
    "test:run": "vitest run src",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "audit:evidence": "node scripts/generate-evidence-audit.mjs",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
